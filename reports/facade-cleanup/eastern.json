      ],
      "location": "Front, side and rear window rows; ground windows beside doors; narrow gate piers and summit rooms",
      "rootCause": "The original slot calculation included glass but omitted 0.525 author units of open shutters and straps. Door flanks and wall ends were not reserved.",
      "proof": "Example: alpine/hotel_2 has 0.78 between front window centres, but each old complete shutter window is 0.995 wide. Adjacent shutters overlap by 0.215. Ground tower windows also crossed the central door surround.",
      "fix": "Fit glass plus shutters and straps to complete wall bay, with 0.045 separation between adjacent complete windows. Reserve 0.08 at wall ends and 0.05 beside door surrounds; centre the side windows within the remaining space. Preserve teal shutters, slats and straps.",
      "sourceFunctions": [
        "shutter_window",
        "timber_shell",
        "core",
        "summit_room",
        "level3_core",
        "public"
      ],
      "constrainedOpenings": 342
    },
    {
      "id": "E2",
      "severity": "confirmed_duplicate_facade",
      "assets": [
        "alpine/tower_2"
      ],
      "location": "Second-floor front central arched window",
      "rootCause": "Generic two-window facade was still authored, then covered by a shallow white plate and overlaid with a third arched window.",
      "proof": "The cover plate front was y=-1.070 while the old straps/frame projected to about y=-1.10. Their outer edges also exceeded the plate width. Both old teal shutter sets visibly survived beside the new arch.",
      "fix": "Skip original front windows at authoring time, remove the masking plate, place the single arched assembly against the real wall and reconnect its balcony deck.",
      "sourceFunctions": [
        "timber_shell",
        "core"
      ]
    },
    {
      "id": "E3",
      "severity": "confirmed_canopy_intersection",
      "assets": [
        "alpine/card_pavilion",
        "alpine/shop_3",
        "compact/shop_3"
      ],
      "location": "Lamps at the shop canopy / noren curtain",
      "rootCause": "Lamps were added using residential positions after the complete store canopy or curtain was already built.",
      "proof": "Alpine card pavilion glass lamps span z=1.065..1.275, while the awning at the same x/y is z approximately 1.211. The shop lamp similarly cuts the left canopy. Kyoto shop_3 paper lamps occupy the noren curtain plane.",
      "fix": "Mount shop lamps on the corner posts outside the cloth; card pavilion lamps sit outside both awning edges.",
      "sourceFunctions": [
        "lantern",
        "awning",
        "shopfront",
        "level3_core",
        "public"
      ]
    },
    {
      "id": "E4",
      "severity": "confirmed_duplicate_facade",
      "assets": [
        "compact/junction_hub",
        "alpine/junction_hub"
      ],
      "location": "Front left information board",
      "rootCause": "Information board was placed in front of an already complete left window.",
      "proof": "Board x=-0.86..-0.34 overlaps the Kyoto window/frame x=-1.1225..-0.5375 and Alpine complete shutter assembly x=-1.2725..-0.3875. The board depth is in front, leaving partial window pieces visible.",
      "fix": "Reserve the left facade for the board, omit the hidden window and its shutters / flowerbox.",
      "sourceFunctions": [
        "public"
      ]
    },
    {
      "id": "E5",
      "severity": "confirmed_extraneous_overlay",
      "assets": [
        "compact/card_pavilion",
        "alpine/card_pavilion"
      ],
      "location": "Three short floating boards in front of each ground window",
      "rootCause": "Additional boards at z=0.25,0.42,0.59 were stacked in front of existing complete windows without supports.",
      "proof": "Upper board z=0.573..0.607 lies across glass that starts at z=0.45 (Kyoto) or z=0.46 (Alpine), separated from the glass plane and conflicting with Alpine window flowerboxes.",
      "fix": "Remove the duplicate six boards; retain the actual framed window, Alpine flowerbox, plants and playing-card sign.",
      "sourceFunctions": [
        "public"
      ]
    }
  ],
